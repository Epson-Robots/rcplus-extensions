<Window x:Class="VanguardModelPFScrewdriver.Dialogs.EditWindow.EditWindowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanguardModelPFScrewdriver.Dialogs.EditWindow"
        xmlns:dialogbehavior="clr-namespace:VanguardModelPFScrewdriver.Dialogs"
        xmlns:utils="clr-namespace:VanguardModelPFScrewdriver.Utils"
        dialogbehavior:DialogBehavior.DialogResult="{Binding CloseResult}"
        mc:Ignorable="d"
        Title="{Binding Captions[WindowSettingsDialog].Value}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.DataContext>
        <local:EditWindowWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <utils:TorqueUnitLocalizer x:Key="TorqueUnitLocalizer" />
        <utils:TorqueValueConverter x:Key="TorqueValueConverter" />
        <utils:FloatToPersistentStringConverter x:Key="FloatToString" />
    </Window.Resources>
    
    <i:Interaction.Behaviors>
        <utils:F1HelpBehavior HelpCommand="{Binding ShowHelpCommand}" />
    </i:Interaction.Behaviors>

    <StackPanel
        Orientation="Vertical"
        Margin="10,6,10,10">

        <DataGrid
            x:Name="WindowList"
            ItemsSource="{Binding WindowItems}"
            SelectedItem="{Binding SelectedWindowItem.Value}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            CanUserReorderColumns="False"
            HeadersVisibility="Column"
            SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Number}"
                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock
                            Text="{Binding DataContext.Captions[WindowSettingsDialog].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Text="{Binding DataContext.Captions[Enabled].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                IsChecked="{Binding IsEnabled.Value, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Text="{Binding DataContext.Captions[StartTurn].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding StartTurn.Value, Converter={StaticResource FloatToString}, ConverterParameter=f1}"
                                TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Text="{Binding StartTurn.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=f1}"
                                InputMethod.IsInputMethodEnabled="False"
                                utils:Hint.Id="{x:Static utils:HintId.WindowStartTurn}"
                                utils:Hint.ToolType="{Binding ToolType}"
                                utils:Hint.Mode="{Binding Mode}"
                                HorizontalContentAlignment="Right">
                                <i:Interaction.Behaviors>
                                    <utils:DecimalPlacesLimiter MaxDecimalPlaces="1" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Text="{Binding DataContext.Captions[EndTurn].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding EndTurn.Value, Converter={StaticResource FloatToString}, ConverterParameter=f1}"
                                TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Text="{Binding EndTurn.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=f1}"
                                InputMethod.IsInputMethodEnabled="False"
                                utils:Hint.Id="{x:Static utils:HintId.WindowEndTurn}"
                                utils:Hint.ToolType="{Binding ToolType}"
                                utils:Hint.Mode="{Binding Mode}"
                                HorizontalContentAlignment="Right">
                                <i:Interaction.Behaviors>
                                    <utils:DecimalPlacesLimiter MaxDecimalPlaces="1" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="DataContext.Captions[TorqueAtStart].Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Converter="{StaticResource TorqueUnitLocalizer}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding TorqueAtStart.Value, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                TextAlignment="Right">
                                <!--
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TorqueValueConverter}">
                                        <Binding Path="TorqueAtStart.Value" />
                                        <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                -->
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Text="{Binding TorqueAtStart.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                InputMethod.IsInputMethodEnabled="False"
                                utils:Hint.Id="{x:Static utils:HintId.WindowTorqueAtStart}"
                                utils:Hint.ToolType="{Binding ToolType}"
                                utils:Hint.Mode="{Binding Mode}"
                                HorizontalContentAlignment="Right">
                                <i:Interaction.Behaviors>
                                    <utils:DecimalPlacesLimiter MaxDecimalPlaces="{Binding DecimalPlaces}" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="DataContext.Captions[TorqueAtEnd].Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Converter="{StaticResource TorqueUnitLocalizer}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding TorqueAtEnd.Value, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                TextAlignment="Right">
                                <!--
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TorqueValueConverter}">
                                        <Binding Path="TorqueAtEnd.Value" Converter="{StaticResource FloatToString}" ConverterParameter="_T" />
                                        <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                -->
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Text="{Binding TorqueAtEnd.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                InputMethod.IsInputMethodEnabled="False"
                                utils:Hint.Id="{x:Static utils:HintId.WindowTorqueAtEnd}"
                                utils:Hint.ToolType="{Binding ToolType}"
                                utils:Hint.Mode="{Binding Mode}"
                                HorizontalContentAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="DataContext.Captions[TorqueWidth].Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Converter="{StaticResource TorqueUnitLocalizer}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding TorqueWidth.Value, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                TextAlignment="Right">
                                <!--
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource TorqueValueConverter}">
                                        <Binding Path="TorqueWidth.Value" Converter="{StaticResource FloatToString}" ConverterParameter="_T" />
                                        <Binding Path="DataContext.TorqueUnit.Value" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                -->
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                Text="{Binding TorqueWidth.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                                InputMethod.IsInputMethodEnabled="False"
                                utils:Hint.Id="{x:Static utils:HintId.WindowTorqueWidth}"
                                utils:Hint.ToolType="{Binding ToolType}"
                                utils:Hint.Mode="{Binding Mode}"
                                HorizontalContentAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border
            Height="25"
            Background="AliceBlue"
            VerticalAlignment="Center"
            Margin="0,2,0,6">
            <Border.Effect>
                <DropShadowEffect
                    Color="Gray"
                    Opacity="0.3"
                    ShadowDepth="2"
                    BlurRadius="4" />
            </Border.Effect>
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding Captions[InputHintLabel].Value}"
                    Margin="10,0,10,0" />
                <TextBlock
                    Text="{Binding Hint.Value}" />
            </StackPanel>
        </Border>

        <DockPanel
            LastChildFill="True"
            Width="640"
            Height="320">
            <ContentControl
                x:Name="PlotArea"
                Content="{Binding PlotControlHolder.Value, Mode=OneWay}" />
        </DockPanel>
        
        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="OK"
                Command="{Binding OKCommand}"
                IsDefault="True"
                Width="80"
                Margin="10,0,0,0"
                Content="{Binding Captions[OK].Value}" />
            <Button
                x:Name="Cancel"
                Command="{Binding CancelCommand}"
                IsCancel="True"
                Width="80"
                Margin="10,0,0,0"
                Content="{Binding Captions[Cancel].Value}" />
        </StackPanel>

    </StackPanel>

</Window>
