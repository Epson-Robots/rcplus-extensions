<Window x:Class="VanguardModelPFScrewdriver.Dialogs.EditProgram.EditProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanguardModelPFScrewdriver.Dialogs.EditProgram"
        xmlns:dialogbehavior="clr-namespace:VanguardModelPFScrewdriver.Dialogs"
        xmlns:utils="clr-namespace:VanguardModelPFScrewdriver.Utils"
        dialogbehavior:DialogBehavior.DialogResult="{Binding CloseResult}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Title>
        <MultiBinding StringFormat="{}{0} [{1}: {2} {3} {4}]">
            <Binding Path="Captions[ProgramEditorDialog].Value" />
            <Binding Path="Captions[ProgramNo].Value" />
            <Binding Path="ProgramNo.Value" />
            <Binding Path="Captions[ToolTypeLabel].Value" />
            <Binding Path="ToolType.Value" />
        </MultiBinding>
    </Window.Title>

    <Window.DataContext>
        <local:EditProgramWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate
            DataType="{x:Type local:StepEditorViewModel}">
            <local:StepEditor />
        </DataTemplate>

        <utils:ModeKindLocalizer x:Key="ModeKindLocalizer" />
        <utils:TorqueUnitLocalizer x:Key="TorqueUnitLocalizer" />
        <utils:FloatToPersistentStringConverter x:Key="FloatToString" />
        <utils:MultiValueConverterAdapter
            x:Key="FloatToStringWithFormat"
            Converter="{StaticResource FloatToString}" />
    </Window.Resources>
    
    <i:Interaction.Behaviors>
        <utils:F1HelpBehavior HelpCommand="{Binding ShowHelpCommand}" />
    </i:Interaction.Behaviors>

    <StackPanel
        Orientation="Vertical"
        Margin="10,6,10,10">

        <Grid
            x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />

                <RowDefinition Height="10" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="10" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />

                <RowDefinition Height="10" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />

                <RowDefinition Height="10" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0" Grid.Column="0"
                Content="{Binding Captions[ProgramNameLabel].Value}"
                HorizontalAlignment="Right" />
            <TextBox
                Grid.Row="0" Grid.Column="2"
                x:Name="ProgramName"
                Text="{Binding Name.Value, UpdateSourceTrigger=PropertyChanged}"
                utils:Hint.Id="{x:Static utils:HintId.ProgramName}"
                utils:Hint.ToolType="{Binding ToolType.Value}"
                utils:Hint.Mode="{Binding SelectedMode.Value}"
                Width="200"
                VerticalAlignment="Center" />
            <Border
                Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3"
                Height="25"
                Background="AliceBlue"
                Margin="20,0,0,0"
                VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect
                        Color="Gray"
                        Opacity="0.3"
                        ShadowDepth="2"
                        BlurRadius="4" />
                </Border.Effect>
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Captions[InputHintLabel].Value}"
                        Margin="10,0,10,0" />
                    <TextBlock
                        Text="{Binding Hint.Value}" />
                </StackPanel>
            </Border>

            <Label
                Grid.Row="2" Grid.Column="2"
                Content="{Binding Captions[Tightening].Value}" />
            <Label
                Grid.Row="2" Grid.Column="4"
                Content="{Binding Captions[Loosening].Value}" />
            <Label
                Grid.Row="2" Grid.Column="6"
                Content="{Binding Captions[Rotation].Value}" />

            <Label
                Grid.Row="4" Grid.Column="0"
                Content="{Binding Captions[DirectionLabel].Value}"
                HorizontalAlignment="Right" />
            <ComboBox
                Grid.Row="4" Grid.Column="2"
                x:Name="TighteningDirection"
                ItemsSource="{Binding Directions}"
                SelectedItem="{Binding SelectedTighteningDirection.Value}"
                Width="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="4" Grid.Column="4"
                x:Name="LooseningDirection"
                ItemsSource="{Binding Directions}"
                SelectedItem="{Binding SelectedLooseningDirection.Value}"
                Width="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="4" Grid.Column="6"
                x:Name="FreeRunDirection"
                ItemsSource="{Binding Directions}"
                SelectedItem="{Binding SelectedFreeRunDirection.Value}"
                Width="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />

            <Label
                Grid.Row="6" Grid.Column="0"
                Content="{Binding Captions[TargetTorqueLabel].Value}"
                HorizontalAlignment="Right" />
            <StackPanel
                Grid.Row="6" Grid.Column="2"
                Orientation="Horizontal">
                <TextBox
                    x:Name="TighteningTorque"
                    Text="{Binding TighteningTargetTorque.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                    InputMethod.IsInputMethodEnabled="False"
                    utils:Hint.Id="{x:Static utils:HintId.Torque}"
                    utils:Hint.ToolType="{Binding ToolType.Value}"
                    utils:Hint.Mode="{Binding SelectedMode.Value}"
                    HorizontalContentAlignment="Right"
                    Width="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <i:Interaction.Behaviors>
                        <utils:DecimalPlacesLimiter MaxDecimalPlaces="{Binding TorqueDecimalPlaces.Value}" />
                    </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Text="{Binding TorqueUnit.Value, Converter={StaticResource TorqueUnitLocalizer}}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel
                Grid.Row="6" Grid.Column="4"
                Orientation="Horizontal">
                <TextBox
                    x:Name="LooseningTorque"
                    Text="{Binding LooseningTargetTorque.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                    InputMethod.IsInputMethodEnabled="False"
                    utils:Hint.Id="{x:Static utils:HintId.Torque}"
                    utils:Hint.ToolType="{Binding ToolType.Value}"
                    utils:Hint.Mode="{Binding SelectedMode.Value}"
                    HorizontalContentAlignment="Right"
                    Width="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <i:Interaction.Behaviors>
                        <utils:DecimalPlacesLimiter MaxDecimalPlaces="{Binding TorqueDecimalPlaces.Value}" />
                    </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock
                    Text="{Binding TorqueUnit.Value, Converter={StaticResource TorqueUnitLocalizer}}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Label
                Grid.Row="8" Grid.Column="0"
                Content="{Binding Captions[StepLabel].Value}"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="10" Grid.Column="0"
                Content="0"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="12" Grid.Column="0"
                Content="1"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="14" Grid.Column="0"
                Content="2"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="16" Grid.Column="0"
                Content="3"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="18" Grid.Column="0"
                Content="4"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="20" Grid.Column="0"
                Content="5"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="22" Grid.Column="0"
                Content="6"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="24" Grid.Column="0"
                Content="7"
                HorizontalAlignment="Right" />
            <Label
                Grid.Row="26" Grid.Column="0"
                Content="8"
                HorizontalAlignment="Right" />

            <Grid
                Grid.Row="8" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    Content="{Binding Captions[NumTurns].Value}"
                    HorizontalAlignment="Center" />
                <Label
                    Grid.Column="1"
                    Content="{Binding Captions[Speed].Value}"
                    HorizontalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    x:Name="TighteningAddStep"
                    Command="{Binding TighteningAddStepCommand}"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center">
                    <Image
                        Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/add.png"
                        Width="20"
                        Height="20"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Margin="-2,-2,0,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
            </Grid>

            <Grid
                Grid.Row="8" Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    Content="{Binding Captions[NumTurns].Value}"
                    HorizontalAlignment="Center" />
                <Label
                    Grid.Column="1"
                    Content="{Binding Captions[Speed].Value}"
                    HorizontalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    x:Name="LooseningAddStep"
                    Command="{Binding LooseningAddStepCommand}"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center">
                    <Image
                        Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/add.png"
                        Width="20"
                        Height="20"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Margin="-2,-2,0,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
            </Grid>
            
            <Grid
                Grid.Row="8" Grid.Column="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    IsEnabled="False"
                    Content="{Binding Captions[NumTurns].Value}"
                    HorizontalAlignment="Center" />
                <Label
                    Grid.Column="1"
                    Content="{Binding Captions[Speed].Value}"
                    HorizontalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    x:Name="FreeRunAddStep"
                    Command="{Binding FreeRunAddStepCommand}"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center">
                    <Image
                        Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/add.png"
                        Width="20"
                        Height="20"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Margin="-2,-2,0,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Button>
            </Grid>

            <ContentPresenter
                Grid.Row="10" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[0]}" />
            <ContentPresenter
                Grid.Row="12" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[1]}" />
            <ContentPresenter
                Grid.Row="14" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[2]}" />
            <ContentPresenter
                Grid.Row="16" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[3]}" />
            <ContentPresenter
                Grid.Row="18" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[4]}" />
            <ContentPresenter
                Grid.Row="20" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[5]}" />
            <ContentPresenter
                Grid.Row="22" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[6]}" />
            <ContentPresenter
                Grid.Row="24" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[7]}" />
            <ContentPresenter
                Grid.Row="26" Grid.Column="2"
                Height="22"
                AllowDrop="True"
                Content="{Binding TighteningSteps[8]}" />
            <Grid
                Grid.Row="9" Grid.RowSpan="18" Grid.Column="2"
                x:Name="TighteningStepsRow"
                Background="Transparent"
                Margin="10,0,0,0"
                AllowDrop="True"
                IsHitTestVisible="False"/>

            <Label
                Grid.Row="28" Grid.Column="0"
                Content="{Binding Captions[SamplingAngleLabel].Value}"
                HorizontalAlignment="Right" />
            <StackPanel
                Grid.Row="28" Grid.Column="2"
                Orientation="Horizontal">
                <TextBox
                    x:Name="SamplingAngle"
                    Text="{Binding SamplingAngle.Value, UpdateSourceTrigger=PropertyChanged}"
                    InputMethod.IsInputMethodEnabled="False"
                    utils:Hint.Id="{x:Static utils:HintId.SamplingAngle}"
                    utils:Hint.ToolType="{Binding ToolType.Value}"
                    utils:Hint.Mode="{Binding SelectedMode.Value}"
                    HorizontalContentAlignment="Right"
                    Width="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="°"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Label
                Grid.Row="30" Grid.Column="0"
                Content="{Binding Captions[TorqueAdjustRateLabel].Value}"
                HorizontalAlignment="Right" />
            <StackPanel
                Grid.Row="30" Grid.Column="2"
                Orientation="Horizontal">
                <TextBox
                    x:Name="TorqueAdjustRate"
                    Text="{Binding TorqueAdjustRate.Value, UpdateSourceTrigger=PropertyChanged}"
                    InputMethod.IsInputMethodEnabled="False"
                    utils:Hint.Id="{x:Static utils:HintId.TorqueAdjustRate}"
                    utils:Hint.ToolType="{Binding ToolType.Value}"
                    utils:Hint.Mode="{Binding SelectedMode.Value}"
                    HorizontalContentAlignment="Right"
                    Width="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="%"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Label
                Grid.Row="32" Grid.Column="0"
                Content="{Binding Captions[WindowLabel].Value}"
                HorizontalAlignment="Right" />
            <Button
                Grid.Row="32" Grid.Column="2"
                x:Name="EditWindow"
                Command="{Binding EditWindowCommand}"
                Content="{Binding Captions[Configure].Value}"
                Width="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />

            <ContentPresenter
                Grid.Row="10" Grid.Column="4"
                Content="{Binding LooseningSteps[0]}" />
            <ContentPresenter
                Grid.Row="12" Grid.Column="4"
                Content="{Binding LooseningSteps[1]}" />
            <Grid
                Grid.Row="9" Grid.RowSpan="5" Grid.Column="4"
                x:Name="LooseningStepsRow"
                Background="Transparent"
                Margin="10,0,0,0"
                AllowDrop="True"
                IsHitTestVisible="False"/>

            <ContentPresenter
                Grid.Row="10" Grid.Column="6"
                Content="{Binding FreeRunSteps[0]}" />

            <GroupBox
                Grid.Row="14" Grid.Column="4"
                Grid.RowSpan="19" Grid.ColumnSpan="3"
                Margin="0,0,10,0">
                <GroupBox.Header>
                    <StackPanel
                        Orientation="Horizontal">
                        <TextBlock
                            Text="{Binding Captions[TighteningSpecialParameters].Value}"
                            VerticalAlignment="Center" />
                        <Label
                            Content="{Binding Captions[TighteningModeLabel].Value}"
                            Margin="20,0,10,0"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="Mode"
                            ItemsSource="{Binding Modes}"
                            SelectedItem="{Binding SelectedMode.Value}"
                            Width="100"
                            VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Converter={StaticResource ModeKindLocalizer}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </GroupBox.Header>
                <DataGrid
                    x:Name="SpecialParams"
                    ItemsSource="{Binding TighteningSpecialParameters}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    CanUserReorderColumns="False"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    Margin="0,6,0,0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Binding="{Binding Effective.Value}">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock
                                    Text="{Binding DataContext.Captions[Enabled].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn
                            Binding="{Binding DisplayName}"
                            IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock
                                    Text="{Binding DataContext.Captions[Name].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.Header>
                                <TextBlock
                                    Text="{Binding DataContext.Captions[Value].Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        TextAlignment="Right"
                                        Width="60">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource FloatToStringWithFormat}">
                                                <Binding Path="ValueHolder.Value.Value" />
                                                <Binding Path="Format" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox
                                        InputMethod.IsInputMethodEnabled="False"
                                        utils:Hint.Id="{Binding HintId}"
                                        utils:Hint.ToolType="{Binding DataContext.ToolType.Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        utils:Hint.Mode="{Binding DataContext.SelectedMode.Value, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        HorizontalContentAlignment="Right"
                                        Width="60">
                                        <TextBox.Text>
                                            <MultiBinding Converter="{StaticResource FloatToStringWithFormat}" UpdateSourceTrigger="PropertyChanged" ValidatesOnNotifyDataErrors="True">
                                                <Binding Path="ValueHolder.Value.Value" ValidatesOnNotifyDataErrors="True" />
                                                <Binding Path="Format" Mode="OneWay" ValidatesOnNotifyDataErrors="False" />
                                            </MultiBinding>
                                        </TextBox.Text>
                                        <i:Interaction.Behaviors>
                                            <utils:DecimalPlacesLimiter MaxDecimalPlaces="{Binding DecimalPlaces}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Available.Value}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>

        </Grid>

        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <CheckBox
                x:Name="UploadCheck"
                IsChecked="{Binding UploadThisProgram.Value}"
                IsEnabled="{Binding CanUploadThisProgram.Value}"
                Content="{Binding Captions[UploadThisProgram].Value}"
                VerticalAlignment="Center" />
            <Button
                x:Name="OK"
                Command="{Binding OKCommand}"
                IsDefault="True"
                Width="80"
                Margin="10,0,0,0"
                Content="{Binding Captions[OK].Value}" />
            <Button
                x:Name="Cancel"
                Command="{Binding CancelCommand}"
                IsCancel="True"
                Width="80"
                Margin="10,0,0,0"
                Content="{Binding Captions[Cancel].Value}" />
        </StackPanel>

    </StackPanel>

</Window>
