<Window x:Class="VanguardModelPFScrewdriver.Dialogs.ConnectFromPC.ConnectFromPCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanguardModelPFScrewdriver.Dialogs.ConnectFromPC"
        xmlns:dialogbehavior="clr-namespace:VanguardModelPFScrewdriver.Dialogs"
        xmlns:utils="clr-namespace:VanguardModelPFScrewdriver.Utils"
        dialogbehavior:DialogBehavior.DialogResult="{Binding CloseResult}"
        mc:Ignorable="d"
        Title="{Binding Captions[ConnectFromPCDialog].Value}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.DataContext>
        <local:ConnectFromPCWindowViewModel />
    </Window.DataContext>

    <i:Interaction.Behaviors>
        <utils:F1HelpBehavior HelpCommand="{Binding ShowHelpCommand}" />
    </i:Interaction.Behaviors>

    <StackPanel
        Orientation="Vertical"
        FocusManager.FocusedElement="{Binding ElementName=IPAddress}"
        Margin="10,6,10,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0" Grid.Column="0"
                Content="{Binding Captions[IPAddressLabel].Value}"
                HorizontalAlignment="Right" />
            <utils:IPAddressInput
                Grid.Row="0" Grid.Column="2"
                x:Name="IPAddress"
                Address="{Binding IPAddress.Value}" />

            <GroupBox
                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Header="{Binding Captions[PanicGroup].Value}"
                Margin="0,10,0,0">
                <StackPanel
                    Orientation="Vertical"
                    Width="360">
                    <TextBlock
                        Text="{Binding Captions[PanicProc1].Value}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc2].Value}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc3].Value}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc4].Value}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc4Sub1].Value}"
                        TextWrapping="Wrap"
                        Margin="20,0,0,0" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc4Sub2].Value}"
                        TextWrapping="Wrap"
                        Margin="20,0,0,0" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc4Sub3].Value}"
                        TextWrapping="Wrap"
                        Margin="20,0,0,0" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc5].Value}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Captions[PanicProc6].Value}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <DockPanel
                Margin="0,10,0,0"
            LastChildFill="True">
            <Button
                x:Name="SetDefault"
                Command="{Binding DefaultSettingsCommand}"
                Content="{Binding Captions[DefaultSettings].Value}"
                Width="80" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="Connect"
                    Command="{Binding OKCommand}"
                    Content="{Binding Captions[Connect].Value}"
                    IsDefault="True"
                    Width="80"
                    Margin="10,0,0,0" />
                <Button
                    x:Name="Cancel"
                    Content="{Binding Captions[Cancel].Value}"
                    IsCancel="True"
                    Width="80"
                    Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>
        
    </StackPanel>

</Window>
