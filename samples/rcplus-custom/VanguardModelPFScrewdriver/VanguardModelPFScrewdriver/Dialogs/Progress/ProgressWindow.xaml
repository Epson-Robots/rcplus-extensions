<Window x:Class="VanguardModelPFScrewdriver.Dialogs.Progress.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanguardModelPFScrewdriver.Dialogs.Progress"
        mc:Ignorable="d"
        Title="{Binding Captions[ExtensionName].Value}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="240">

    <Window.DataContext>
        <local:ProgressWindowViewModel />
    </Window.DataContext>
    
    <StackPanel
        Orientation="Vertical"
        Margin="10">

        <TextBlock
            Text="{Binding Message.Value}"
            TextWrapping="Wrap" />

        <ProgressBar
            x:Name="Indicator"
            IsIndeterminate="{Binding IsIndeterminate.Value}"
            Value="{Binding Value.Value}"
            Minimum="{Binding Minimum.Value}"
            Maximum="{Binding Maximum.Value}"
            Width="200"
            Height="20"
            Margin="0,10,0,0"/>

        <Button
            x:Name="Cancel"
            Command="{Binding CancelCommand}"
            Content="{Binding Captions[Cancel].Value}"
            Width="80"
            Margin="0,10,0,0"/>

    </StackPanel>

</Window>
