<UserControl x:Class="VanguardModelPFScrewdriver.Utils.IPAddressInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VanguardModelPFScrewdriver.Utils"
             mc:Ignorable="d"
             Focusable="True"
             d:DesignHeight="30" d:DesignWidth="200">

    <StackPanel
        Orientation="Horizontal">
        <TextBox
            x:Name="Octet1"
            local:TextBoxBehavior.IsSelectAllOnFocus="True"
            InputMethod.IsInputMethodEnabled="False"
            Tag="0"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="40" />
        <TextBlock
            VerticalAlignment="Center"
            Margin="3,0,3,0"
            Text="." />
        <TextBox
            x:Name="Octet2"
            local:TextBoxBehavior.IsSelectAllOnFocus="True"
            InputMethod.IsInputMethodEnabled="False"
            Tag="1"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="40" />
        <TextBlock
            VerticalAlignment="Center"
            Margin="3,0,3,0"
            Text="." />
        <TextBox
            x:Name="Octet3"
            local:TextBoxBehavior.IsSelectAllOnFocus="True"
            InputMethod.IsInputMethodEnabled="False"
            Tag="2"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="40" />
        <TextBlock
            VerticalAlignment="Center"
            Margin="3,0,3,0"
            Text="." />
        <TextBox
            x:Name="Octet4"
            local:TextBoxBehavior.IsSelectAllOnFocus="True"
            InputMethod.IsInputMethodEnabled="False"
            Tag="3"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="40" />
    </StackPanel>

</UserControl>
