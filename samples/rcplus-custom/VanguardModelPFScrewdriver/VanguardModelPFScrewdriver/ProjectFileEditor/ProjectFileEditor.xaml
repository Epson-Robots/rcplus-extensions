<UserControl x:Class="VanguardModelPFScrewdriver.ProjectFileEditor.ProjectFileEditor"
             x:Name="TopLevel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:VanguardModelPFScrewdriver.ProjectFileEditor"
             xmlns:utils="clr-namespace:VanguardModelPFScrewdriver.Utils"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.DataContext>
        <local:ProjectFileEditorViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <utils:IsNotNullConverter x:Key="IsNotNull" />
        <utils:BoolsAndConverter x:Key="BoolsAnd" />

        <utils:TighteningErrorDetailConverter x:Key="ErrorDetailConverter" />
        <utils:ErrorOperationConverter x:Key="ErrorOperationConverter" />

        <utils:BindingProxy
            x:Key="Proxy"
            Data="{Binding DataContext, ElementName=TopLevel}" />

        <utils:TorqueUnitLocalizer x:Key="TorqueUnitLocalizer" />
        <utils:TorqueValueConverter x:Key="TorqueValueConverter" />
        <utils:FloatToPersistentStringConverter x:Key="FloatToString" />
    </UserControl.Resources>

    <Grid
        Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="*" MaxWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Orientation="Vertical">
                <DockPanel
                    Height="28"
                    Background="{DynamicResource {x:Static SystemColors.MenuBarBrushKey}}">
                    <Button
                        x:Name="EditPreferences"
                        Command="{Binding PreferencesCommand}"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0">
                        <Image
                            Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/preferences.png"
                            Width="20"
                            Height="20"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Margin="-2,-2,0,0" />
                    </Button>
                </DockPanel>
                <GroupBox
                    Header="{Binding Captions[NetworkGroup].Value}"
                    Margin="2,4,2,0">
                    <StackPanel
                        Orientation="Vertical"
                        Margin="10,6,10,6">
                        <Button
                            x:Name="ConnectToCTConts"
                            Command="{Binding FromPCCommand.Value}"
                            Content="{Binding FromPCCaption.Value.Value}" />
                        <Button
                            x:Name="EditControllerSettings"
                            Command="{Binding ControllerSettingsCommand}"
                            Content="{Binding Captions[ControllerSettings].Value}"
                            Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Margin="2,4,2,0">
                    <GroupBox.Header>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding Captions[SysInfoGroup].Value}"
                                VerticalAlignment="Center"/>
                            <Button
                                x:Name="ShowSysInfo"
                                Command="{Binding SystemInformationCommand}"
                                Width="20"
                                Height="20"
                                Margin="10,0,0,0">
                                <Image
                                    Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/information.png"
                                    Width="20"
                                    Height="20"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Margin="-2,-2,0,0" />
                            </Button>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel
                        Orientation="Vertical">
                        <Grid
                            Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0" Grid.Column="0"
                                Content="CT-CONTS ID:"
                                HorizontalAlignment="Right" />
                            <ComboBox
                                x:Name="CTContsIdSelector"
                                Grid.Row="0" Grid.Column="2"
                                ItemsSource="{Binding CTContsIds}"
                                SelectedItem="{Binding SelectedCTContsId.Value}"
                                IsEnabled="{Binding CanChangeCTContsId.Value}"
                                IsReadOnly="True"
                                Width="60"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding StringFormat={}{0:D3}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Label
                                Grid.Row="2" Grid.Column="0"
                                Content="{Binding Captions[ToolTypeLabel].Value}"
                                HorizontalAlignment="Right" />
                            <ComboBox
                                x:Name="ToolTypeSelector"
                                Grid.Row="2" Grid.Column="2"
                                ItemsSource="{Binding ToolTypes}"
                                SelectedItem="{Binding SelectedToolType.Value}"
                                IsEnabled="{Binding CanChangeToolType.Value}"
                                IsReadOnly="True"
                                Width="60"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Margin="2,4,2,0">
                    <GroupBox.Header>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding Captions[ProgramGroup].Value}"
                                VerticalAlignment="Center" />
                            <Menu
                                Margin="10,0,0,0">
                                <MenuItem
                                    ItemsSource="{Binding ProgramMenuItems}"
                                    Width="20"
                                    Height="20"
                                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1">
                                    <MenuItem.Icon>
                                        <Image
                                            Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/menu.png"
                                            Width="20"
                                            Height="20"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            Margin="-3,-2,0,0" />
                                    </MenuItem.Icon>
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title.Value}" />
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled.Value}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Command, Converter={StaticResource IsNotNull}}" Value="True">
                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGroupTitle}" Value="True">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="MenuItem">
                                                                <Separator
                                                                    Height="0.3"
                                                                    Margin="30,2,0,2" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel
                        Orientation="Vertical"
                        Margin="0,4,0,4">
                        <DockPanel
                            LastChildFill="True">
                            <Button
                                DockPanel.Dock="Right"
                                x:Name="EditProgram"
                                Command="{Binding EditProgramCommand}"
                                Width="20"
                                Height="20">
                                <Image
                                    Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/edit.png"
                                    Width="20"
                                    Height="20"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Margin="-2,-2,0,0" />
                            </Button>
                            <ComboBox
                                x:Name="ProgramSelector"
                                ItemsSource="{Binding ProgramItems}"
                                SelectedItem="{Binding SelectedProgramItem.Value}"
                                DisplayMemberPath="DisplayName.Value"
                                IsReadOnly="True"
                                VerticalAlignment="Center"
                                Margin="10,0,10,0" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="1" Grid.Column="0"
                                Content="{Binding Captions[Tightening].Value}"
                                HorizontalAlignment="Right" />
                            <Button
                                Grid.Row="1" Grid.Column="2"
                                x:Name="StartOrStopTightening"
                                Command="{Binding TighteningCommand.Value}"
                                Content="{Binding TighteningCaption.Value.Value}"
                                Width="80"
                                VerticalAlignment="Center" />
                            <Label
                                Grid.Row="3" Grid.Column="0"
                                Content="{Binding Captions[Loosening].Value}"
                                HorizontalAlignment="Right" />
                            <Button
                                Grid.Row="3" Grid.Column="2"
                                x:Name="StartOrStopLoosening"
                                Command="{Binding LooseningCommand.Value}"
                                Content="{Binding LooseningCaption.Value.Value}"
                                Width="80"
                                VerticalAlignment="Center" />
                            <Label
                                Grid.Row="5" Grid.Column="0"
                                Content="{Binding Captions[Rotation].Value}"
                                HorizontalAlignment="Right" />
                            <Button
                                Grid.Row="5" Grid.Column="2"
                                x:Name="StartOrStopFreeRun"
                                Command="{Binding FreeRunCommand.Value}"
                                Content="{Binding FreeRunCaption.Value.Value}"
                                Width="80"
                                VerticalAlignment="Center" />
                        </Grid>
                        <GroupBox
                            Header="{Binding Captions[OperationState].Value}"
                            Margin="2,4,2,0">
                            <GroupBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BoolsAnd}">
                                    <Binding Path="HasCTContsConnection.Value" />
                                    <Binding Path="CanSaveFile.Value" />
                                </MultiBinding>
                            </GroupBox.IsEnabled>
                            <Grid
                                Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    Grid.Column="0"
                                    IsChecked="{Binding EndState.Value}"
                                    Content="END"
                                    IsHitTestVisible="False" />
                                <RadioButton
                                    Grid.Column="1"
                                    IsChecked="{Binding BusyState.Value}"
                                    Content="BUSY"
                                    IsHitTestVisible="False" />
                                <RadioButton
                                    Grid.Column="2"
                                    IsChecked="{Binding ErrState.Value}"
                                    Content="ERR"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Margin="2,4,2,0">
                    <GroupBox.Header>
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding Captions[VacuumControl].Value}"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="EditVacuumSettings"
                                Command="{Binding VacuumSettingsCommand}"
                                Width="20"
                                Height="20"
                                Margin="10,0,0,0">
                                <Image
                                    Source="/VanguardModelPFScrewdriver_728ed9c2-e8ca-4935-aeeb-2afba2bf2626;component/Resources/Images/edit.png"
                                    Width="20"
                                    Height="20"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Margin="-2,-2,0,0" />
                            </Button>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel
                        Orientation="Vertical"
                        Margin="10,4,0,4">
                        <CheckBox
                            x:Name="VacuumOnTrigger"
                            Command="{Binding VacuumOnCommand}"
                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                            IsEnabled="{Binding VacuumOnLabel.Value, Converter={StaticResource IsNotNull}}"
                            Content="{Binding Captions[VacuumOn].Value}" />
                        <CheckBox
                            x:Name="VacuumBreakOnTrigger"
                            Command="{Binding VacuumBreakOnCommand}"
                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                            IsEnabled="{Binding VacuumBreakOnLabel.Value, Converter={StaticResource IsNotNull}}"
                            Content="{Binding Captions[VacuumBreakOn].Value}"
                            Margin="0,4,0,0" />
                        <RadioButton
                            IsChecked="{Binding SuctionState.Value}"
                            Content="{Binding Captions[VacuumSuctionState].Value}"
                            IsHitTestVisible="False"
                            Margin="0,6,0,0">
                            <RadioButton.IsEnabled>
                                <MultiBinding Converter="{StaticResource BoolsAnd}">
                                    <Binding Path="SuctionStateLabel.Value" Converter="{StaticResource IsNotNull}" />
                                    <Binding Path="HasRobotControllerConnection.Value" />
                                </MultiBinding>
                            </RadioButton.IsEnabled>
                        </RadioButton>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter
            Grid.Column="1"
            x:Name="VerticalSplitter"
            ShowsPreview="True"
            HorizontalAlignment="Stretch" />

        <Grid
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <DockPanel
                LastChildFill="True">
 
                <StackPanel
                    DockPanel.Dock="Top"
                    Visibility="{Binding FetchLogPanelVisibility.Value}"
                    Orientation="Horizontal"
                    Margin="10, 6, 10, 6">
                    <Button
                        x:Name="FetchLog"
                        Command="{Binding FetchFromControllerCommand}"
                        Content="{Binding Captions[FetchFromController].Value}"
                        Width="180"/>
                    <Button
                        x:Name="SelectUSBDrive"
                        Command="{Binding SelectUSBDriveCommand}"
                        Visibility="{Binding SelectUSBVisibility.Value}"
                        Content="{Binding Captions[SelectUSBDrive].Value}"
                        Width="180"
                        Margin="20,0,0,0" />
                    <TextBlock
                        Visibility="{Binding SelectUSBVisibility.Value}"
                        Text="{Binding SelectedUSBDrive.Value}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                </StackPanel>

                <TabControl
                    DockPanel.Dock="Top"
                    Grid.Row="0">
                    <TabItem
                        Header="{Binding Captions[ResultLog].Value}">
                        <DataGrid
                            x:Name="ResultLogs"
                            ItemsSource="{Binding TighteningResults}"
                            SelectedItem="{Binding SelectedTighteningResult.Value}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                            HeadersVisibility="Column"
                            SelectionMode="Single">
                            <i:Interaction.Behaviors>
                                <utils:ScrollSelectedItemIntoViewBehavior />
                            </i:Interaction.Behaviors>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding LineNo}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[LineNo].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding TimeStamp, StringFormat={}{0:yyyy-MM-dd hh:mm:ss}}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[DateTime].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding ProgramNo}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[ProgramNo].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding NumTurns}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[NumTurns].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Data.Captions[MaxTorque].Value" Source="{StaticResource Proxy}" />
                                                    <Binding Path="Data.TorqueUnit.Value" Source="{StaticResource Proxy}" Converter="{StaticResource TorqueUnitLocalizer}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource TorqueValueConverter}">
                                                        <Binding Path="Torque" />
                                                        <Binding Path="Data.TorqueUnit.Value" Source="{StaticResource Proxy}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Binding="{Binding ElapsedTime}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[ElapsedTime].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding Result}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[Result].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[ErrorDetail].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="OK">
                                                                <Setter Property="Text" Value="" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="NG">
                                                                <Setter Property="Text" Value="{Binding ErrorDetail, Converter={StaticResource ErrorDetailConverter}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[DrawWave].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding DrawWave.Value, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanDrawWave.Value}"
                                                HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem
                        Header="{Binding Captions[ErrorLog].Value}">
                        <DataGrid
                            x:Name="ErrorLogs"
                            ItemsSource="{Binding Errors}"
                            SelectedItem="{Binding SelectedError.Value}"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                            HeadersVisibility="Column"
                            SelectionMode="Single">
                            <i:Interaction.Behaviors>
                                <utils:ScrollSelectedItemIntoViewBehavior />
                            </i:Interaction.Behaviors>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding LineNo}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[LineNo].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding TimeStamp, StringFormat={}{0:yyyy-MM-dd hh:mm:ss}}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[DateTime].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Binding="{Binding ErrorOperation, Converter={StaticResource ErrorOperationConverter}}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="{Binding Data.Captions[Operation].Value, Source={StaticResource Proxy}}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            
            </DockPanel>

            <GridSplitter
                Grid.Row ="1"
                x:Name="HorizontalSplitter"
                HorizontalAlignment="Stretch" />

            <DockPanel
                Grid.Row="2"
                LastChildFill="True">
                <Grid
                    DockPanel.Dock="Top"
                    HorizontalAlignment="Right"
                    Margin="0,3,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="20" />
                        
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        Content="{Binding Captions[TorqueUpperLimitLabel].Value}" />
                    <RadioButton
                        Grid.Column="2"
                        x:Name="YAutoScale"
                        IsChecked="{Binding TorqueAutoScaling.Value}"
                        GroupName="TorqueRange"
                        Content="{Binding Captions[ScaleAuto].Value}"
                        VerticalAlignment="Center" />
                    <RadioButton
                        Grid.Column="4"
                        x:Name="YFixedScale"
                        IsChecked="{Binding TorqueFixedScaling.Value}"
                        GroupName="TorqueRange"
                        Content="{Binding Captions[ScaleFixed].Value}"
                        VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="6"
                        x:Name="YScale"
                        Text="{Binding TorqueUpperLimit.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=_T}"
                        Width="70"
                        HorizontalContentAlignment="Right"
                        VerticalAlignment="Center">
                        <i:Interaction.Behaviors>
                            <utils:DecimalPlacesLimiter MaxDecimalPlaces="{Binding TorqueDecimalPlaces.Value}" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock
                        Grid.Column="8"
                        Text="{Binding TorqueUnit.Value, Converter={StaticResource TorqueUnitLocalizer}}"
                        VerticalAlignment="Center" />

                    <Label
                        Grid.Column="10"
                        Content="{Binding Captions[NumTurnsUpperLimitLabel].Value}" />
                    <RadioButton
                        Grid.Column="12"
                        x:Name="XAutoScale"
                        IsChecked="{Binding NumTurnsAutoScaling.Value}"
                        GroupName="NumTurnsRange"
                        Content="{Binding Captions[ScaleAuto].Value}"
                        VerticalAlignment="Center" />
                    <RadioButton
                        Grid.Column="14"
                        x:Name="XFixedScale"
                        IsChecked="{Binding NumTurnsFixedScaling.Value}"
                        GroupName="NumTurnsRange"
                        Content="{Binding Captions[ScaleFixed].Value}"
                        VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="16"
                        x:Name="XScale"
                        Text="{Binding NumTurnsUpperLimit.Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FloatToString}, ConverterParameter=f1}"
                        Width="50"
                        HorizontalContentAlignment="Right"
                        VerticalAlignment="Center">
                        <i:Interaction.Behaviors>
                            <utils:DecimalPlacesLimiter MaxDecimalPlaces="1" />
                        </i:Interaction.Behaviors>
                    </TextBox>
                </Grid>
                <ContentControl
                    DockPanel.Dock="Top"
                    Content="{Binding PlotControlHolder.Value, Mode=OneWay}" />
            </DockPanel>
        </Grid>
    </Grid>
    
</UserControl>
