<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <CaptionsSource>Captions.xlsx</CaptionsSource>
    <CaptionsGeneratedMarker>obj\Captions.stamp</CaptionsGeneratedMarker>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>$(ExtensionId)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="install.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Libraries\SpelLoggerLib.zip">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\English_en\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\Japanese_ja\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\German_de\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\French_fr\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\Spanish_es\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\Chinese(Simplefied)_zh-Hans\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Strings\Chinese(Traditional)_zh-Hant\SpelAnalysisTool.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Extension.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="PackageItems\manifest.rcxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ManifestEditor>true</ManifestEditor>
    </Content>
    <Content Include="PackageItems\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Libraries\SpelLoggerLib.zip" />
    <None Remove="Resources\SmpUsingSpelLogger.prg" />
    <None Remove="Resources\SpelLogger.prg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Epson.RoboticsShared.ExtensionsAPI" Version="$(ExtensionsApiVersion)" />
    <PackageReference Include="ReactiveProperty.WPF" Version="7.12.0" />
    <PackageReference Include="System.ComponentModel.Composition" Version="4.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\SmpUsingSpelLogger.prg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\SpelLogger.prg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <Target Name="GenerateCaptionResources" BeforeTargets="PreBuildEvent" Inputs="$(CaptionsSource)" Outputs="$(CaptionsGeneratedMarker)">
    <Message Text="Create Caption Resources" Importance="high" />
    <Exec Command="&quot;$(EPSON_RC80_EXTENSIONS_API_DIR)\Tools\generateStringResources.exe&quot; &quot;$(CaptionsSource)&quot; &quot;localized strings&quot; --outdir Resources\Strings --basename &quot;$(ProjectName)&quot; --symbol Constants.cs" />
    <Touch Files="$(CaptionsGeneratedMarker)" AlwaysCreate="true" />
  </Target>

  <Target Name="DeleteMarkerThenUninstall" AfterTargets="Clean">
    <Delete Files="$(CaptionsGeneratedMarker)" />
    <CallTarget Targets="Uninstall" />
  </Target>

  <Target Name="Install" AfterTargets="PostBuildEvent">
    <Message Text="Install Extension Binaries for Experimental Mode" Importance="high" />
    <Exec Command="&quot;$(EPSON_RC80_EXTENSIONS_API_DIR)\Tools\extensionInstaller.exe&quot; install.json &quot;bin\$(PlatformTarget)\$(Configuration)\$(TargetFramework)&quot; &quot;$(EPSON_RC80_DIR)&quot;" />
  </Target>

  <Target Name="Uninstall">
    <Message Text="Uninstall Extension Binaries for Experimental Mode" Importance="high" />
    <Exec Command="&quot;$(EPSON_RC80_EXTENSIONS_API_DIR)\Tools\extensionInstaller.exe&quot; -u install.json &quot;bin\$(PlatformTarget)\$(Configuration)\$(TargetFramework)&quot; &quot;$(EPSON_RC80_DIR)&quot;" />
  </Target>

  <Target Name="Packaging">
    <Message Text="Create RC+ Extensions Package" Importance="high" />
    <Exec Command="&quot;$(EPSON_RC80_EXTENSIONS_API_DIR)\Tools\validateManifest.exe&quot; PackageItems\manifest.rcxmanifest" />
    <Exec Command="&quot;$(EPSON_RC80_EXTENSIONS_API_DIR)\Tools\generatePackage.exe&quot; . &quot;bin\$(PlatformTarget)\$(Configuration)&quot; &quot;$(Configuration)&quot;" />
  </Target>

</Project>
