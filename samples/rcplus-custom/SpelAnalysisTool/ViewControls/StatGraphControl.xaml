<UserControl x:Class="SpelAnalysisTool.ViewControls.StatGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="_txtYMax" Text="" Margin="0 0 0 0"/>
        <TextBlock Grid.Row="2" x:Name="_txtYMin" Text="" Margin="0 0 0 0"/>
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid Margin="0 -2 0 0">
                    <Path x:Name="_pathLineSigma" Stretch="Fill" StrokeThickness="1" StrokeDashArray="2" Stroke="#E8E8E8" Data="M0,0 L1,0 1,1 1,0 2,0"/>
                </Grid>
                <Grid Margin="0 3 0 0">
                    <Path x:Name="_pathBarGraph" Stretch="Fill" StrokeThickness="1" Stroke="#B0B0FF" Fill="#E0E0FF" Data="M0,0 L1,1 0,2 Z"/>
                    <Path x:Name="_pathLineGraph" Stretch="Fill" StrokeThickness="1" Stroke="Green" Data="M0,0 L1,1"/>
                </Grid>
                <Grid Margin="0 -2 0 0">
                    <Path x:Name="_pathLineCurrent" Stretch="Fill" StrokeThickness="1" Stroke="DodgerBlue" Data="M0,0 L1,0 1,1"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
