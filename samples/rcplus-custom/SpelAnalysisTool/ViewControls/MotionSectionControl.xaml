<UserControl x:Class="SpelAnalysisTool.ViewControls.MotionSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200">
    <Border BorderThickness="0" BorderBrush="#F0F0F0" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" Margin="0 -1 0 0">
                <Path Data="M0,1 L0,0 1,0" Stretch="Fill" StrokeThickness="1" Stroke="#A0A0A0" StrokeDashArray="2"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0 -1 0 0">
                <Path Data="M1,1 L1,0 0,0" Stretch="Fill" StrokeThickness="1" Stroke="#A0A0A0" StrokeDashArray="2"/>
            </Grid>
            <Grid Grid.Row="0" x:Name="_gridHeader" Background="DodgerBlue">
                <TextBlock x:Name="_txtTitle" Text="AAA" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="4 0 0 0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
