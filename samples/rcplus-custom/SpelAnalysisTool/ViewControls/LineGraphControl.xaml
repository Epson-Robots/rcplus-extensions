<UserControl x:Class="SpelAnalysisTool.ViewControls.LineGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="_txtYMax" Text="" FontSize="10" Margin="0 -10 0 0"/>
        <TextBlock Grid.Row="2" x:Name="_txtYMin" Text="" FontSize="10" Margin="0 -3 0 0"/>
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" ClipToBounds="True" Background="#10303030">
            <Grid>
                <Path x:Name="_pathScale" Stretch="Fill" StrokeThickness="1" Stroke="LightGray"/>
                <Path x:Name="_pathChkMinMax" Stretch="Fill" StrokeThickness="1" Fill="#20FF0000"/>
                <Path x:Name="_path" Stretch="Fill" StrokeThickness="1" Stroke="Green"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
