<UserControl x:Class="SpelAnalysisTool.ViewControls.CellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40">
    <Border x:Name="_border" BorderBrush="Gray" Background="Transparent" BorderThickness="1" CornerRadius="2">
        <Grid>
            <TextBlock x:Name="_txtName" Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="_txtIdx" Text="a" FontSize="10" Margin="2 -2 0 0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </Border>
</UserControl>
