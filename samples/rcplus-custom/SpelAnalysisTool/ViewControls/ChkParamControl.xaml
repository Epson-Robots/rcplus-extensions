<UserControl x:Class="SpelAnalysisTool.ViewControls.ChkParamControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d"
             d:DesignWidth="200">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabledMin}" VerticalAlignment="Center"/>
        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabledMax}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="4 0 0 0"/>
        <TextBox Grid.Column="3" Text="{Binding Min}" HorizontalContentAlignment="Right" IsEnabled="{Binding IsEnabledMin}"/>
        <TextBlock Grid.Column="4" Text="-"/>
        <TextBox Grid.Column="5" Text="{Binding Max}" HorizontalContentAlignment="Right" IsEnabled="{Binding IsEnabledMax}"/>
        <TextBlock Grid.Column="6" Text="{Binding Unit}" Margin="4 0 0 0"/>
    </Grid>
</UserControl>
