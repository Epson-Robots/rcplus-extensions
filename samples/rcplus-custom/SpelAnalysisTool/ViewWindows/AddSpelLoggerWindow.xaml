<Window x:Class="SpelAnalysisTool.ViewWindows.AddSpelLoggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpelAnalysisTool"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Path=[AddSpelLogger_Title].Value, Source={x:Static local:Main.Captions}}" Width="360" SizeToContent="Height">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="_btnOK" Content="{Binding Path=[Common_OK].Value, Source={x:Static local:Main.Captions}}"/>
            <Button x:Name="_btnCancel" Content="{Binding Path=[Common_Cancel].Value, Source={x:Static local:Main.Captions}}" Margin="4 0 0 0"/>
        </StackPanel>
        <StackPanel Margin="0 0 0 16">
            <TextBlock Text="{Binding Path=[AddSpelLogger_SpelLoggerType].Value, Source={x:Static local:Main.Captions}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8">
                <RadioButton x:Name="_radioButtonFile" Content="{Binding Path=[AddSpelLogger_File].Value, Source={x:Static local:Main.Captions}}" IsChecked="True"/>
                <RadioButton x:Name="_radioButtonLibrary" Content="{Binding Path=[AddSpelLogger_Library].Value, Source={x:Static local:Main.Captions}}" Margin="8 0 0 0"/>
            </StackPanel>
            <CheckBox x:Name="_checkBoxAddSample" Margin="0 8 0 0">
                <TextBlock Text="{Binding Path=[AddSpelLogger_AddSample].Value, Source={x:Static local:Main.Captions}}" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
    </DockPanel>
</Window>
