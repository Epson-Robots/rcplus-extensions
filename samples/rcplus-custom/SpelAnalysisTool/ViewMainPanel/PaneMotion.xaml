<UserControl x:Class="SpelAnalysisTool.ViewMainPanel.PaneMotion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool"
             xmlns:vc="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <TabControl>
            <TabItem x:Name="_tabMotion">
                <TabItem.Header>
                    <vc:ListInfoHeaderControl x:Name="_headerMotion" TxtName="Motion"/>
                </TabItem.Header>
                <Grid Margin="4 0 4 4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Grid x:Name="_gridGraphCursor" Background="Transparent">
                            <Path x:Name="_pathLineMotionCurrent" Stretch="Fill" StrokeThickness="1" Stroke="DodgerBlue" Data="M0,0 L1,0 1,1 1,0 2,0" Visibility="Hidden"/>
                        </Grid>
                        <Grid x:Name="_gridGraphBar" IsHitTestVisible="False"/>
                        <Grid x:Name="_gridGraph" Margin="0 20 0 0" Cursor=""/>
                    </Grid>
                    <GridSplitter Grid.Row="1" Height="8" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" Cursor="SizeNS"/>
                    <DataGrid
                        Grid.Row="2"  
                        x:Name="_dataGrid"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        HorizontalGridLinesBrush="LightGray"
                        VerticalGridLinesBrush="LightGray"
                        HeadersVisibility="Column"
                        VerticalScrollBarVisibility="Visible"
                        SelectionMode="Single"
                        CanUserAddRows="False"
                        CanUserSortColumns="False"
                        CanUserResizeRows="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#eee"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Padding" Value="4 1"/>
                                <Setter Property="BorderBrush" Value="LightGray"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="HAlignmentCenterStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="HAlignmentRightStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="_colCycleNo" Width="38" Binding="{Binding CycleNo}" Header="Cycle" ElementStyle="{StaticResource HAlignmentCenterStyle}"/>
                            <DataGridTextColumn x:Name="_colTime" Width="40" Binding="{Binding ElapsedTime, StringFormat={}{0:N3}}" Header="Time" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colDateTime" Width="120" Binding="{Binding DateTime}" Header="DateTime" ElementStyle="{StaticResource HAlignmentCenterStyle}"/>
                            <DataGridTextColumn x:Name="_colSectionName" Width="100" Binding="{Binding SectionName}" Header="SectionName" ElementStyle="{StaticResource HAlignmentCenterStyle}"/>
                            <DataGridTextColumn x:Name="_colVelocity" Width="*" Binding="{Binding Velocity, StringFormat={}{0:N3}}" Header="Velocity" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTCPSpeed" Width="*" Binding="{Binding TCPSpeed, StringFormat={}{0:N3}}" Header="TCPSpeed" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colX" Width="*" Binding="{Binding PosX, StringFormat={}{0:N3}}" Header="X" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colY" Width="*" Binding="{Binding PosY, StringFormat={}{0:N3}}" Header="Y" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colZ" Width="*" Binding="{Binding PosZ, StringFormat={}{0:N3}}" Header="Z" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colU" Width="*" Binding="{Binding PosU, StringFormat={}{0:N3}}" Header="U" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colV" Width="*" Binding="{Binding PosV, StringFormat={}{0:N3}}" Header="V" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colW" Width="*" Binding="{Binding PosW, StringFormat={}{0:N3}}" Header="W" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ1" Width="*" Binding="{Binding Joint[0], StringFormat={}{0:N3}}" Header="J1" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ2" Width="*" Binding="{Binding Joint[1], StringFormat={}{0:N3}}" Header="J2" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ3" Width="*" Binding="{Binding Joint[2], StringFormat={}{0:N3}}" Header="J3" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ4" Width="*" Binding="{Binding Joint[3], StringFormat={}{0:N3}}" Header="J4" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ5" Width="*" Binding="{Binding Joint[4], StringFormat={}{0:N3}}" Header="J5" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colJ6" Width="*" Binding="{Binding Joint[5], StringFormat={}{0:N3}}" Header="J6" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ1" Width="*" Binding="{Binding Torque[0], StringFormat={}{0:N3}}" Header="TQ1" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ2" Width="*" Binding="{Binding Torque[1], StringFormat={}{0:N3}}" Header="TQ2" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ3" Width="*" Binding="{Binding Torque[2], StringFormat={}{0:N3}}" Header="TQ3" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ4" Width="*" Binding="{Binding Torque[3], StringFormat={}{0:N3}}" Header="TQ4" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ5" Width="*" Binding="{Binding Torque[4], StringFormat={}{0:N3}}" Header="TQ5" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                            <DataGridTextColumn x:Name="_colTQ6" Width="*" Binding="{Binding Torque[5], StringFormat={}{0:N3}}" Header="TQ6" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" x:Name="_wrapPanelColShow" Orientation="Horizontal" Margin="0 2 0 0">
                        <WrapPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0 0 6 0"/>
                            </Style>
                        </WrapPanel.Resources>
                        <CheckBox Content="Dummy1"/>
                        <CheckBox Content="Dummy2"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -2 0 0">
            <TextBlock Text="{Binding Path=[Motion_GraphNum].Value, Source={x:Static local:Main.Captions}}" Margin="0 0 8 0" VerticalAlignment="Center"/>
            <ComboBox x:Name="_comboBoxGraphNum"/>
        </StackPanel>
    </Grid>
</UserControl>
