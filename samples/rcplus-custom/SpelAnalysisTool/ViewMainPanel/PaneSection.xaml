<UserControl x:Class="SpelAnalysisTool.ViewMainPanel.PaneSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewMainPanel"
             xmlns:vc="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <TabControl>
            <TabItem x:Name="_tabSection" Cursor="">
                <TabItem.Header>
                    <vc:ListInfoHeaderControl x:Name="_headerSection" TxtName="Section"/>
                </TabItem.Header>
                <DataGrid
                    x:Name="_dataGrid"
                    Margin="4"
                    IsReadOnly="True"
                    RowHeight="30"
                    AutoGenerateColumns="False"
                    HorizontalGridLinesBrush="LightGray"
                    VerticalGridLinesBrush="LightGray"
                    HeadersVisibility="Column"
                    VerticalScrollBarVisibility="Visible"
                    SelectionMode="Single"
                    CanUserAddRows="False"
                    CanUserSortColumns="False"
                    CanUserResizeRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#eee"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Padding" Value="4 1"/>
                            <Setter Property="BorderBrush" Value="LightGray"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="HAlignmentCenterStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="HAlignmentRightStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*" Binding="{Binding SectionName}" Header="SectionName"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Count}" Header="Cnt" ElementStyle="{StaticResource HAlignmentRightStyle}" Visibility="Hidden"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Percentage, StringFormat={}{0:N1}}" Header="pct." ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding StdDev, StringFormat={}{0:N3}}" Header="StdDev" ElementStyle="{StaticResource HAlignmentRightStyle}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStdDevNG}" Value="True">
                                            <Setter Property="Background" Value="Red" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding Mean, StringFormat={}{0:N3}}" Header="Mean" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Min, StringFormat={}{0:N3}}" Header="Min" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Max, StringFormat={}{0:N3}}" Header="Max" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Range, StringFormat={}{0:N3}}" Header="Range" ElementStyle="{StaticResource HAlignmentRightStyle}"/>
                        <DataGridTemplateColumn Width="2*" Header="Disribution">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding StatGraph}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="4*" Header="Timeline">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding TimelineBar}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
