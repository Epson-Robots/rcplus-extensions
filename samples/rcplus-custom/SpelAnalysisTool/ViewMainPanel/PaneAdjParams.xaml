<UserControl x:Class="SpelAnalysisTool.ViewMainPanel.PaneAdjParams"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool"
             xmlns:vc="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <TabControl>
            <TabItem Header="{Binding Path=[AdjParams_Title].Value, Source={x:Static local:Main.Captions}}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="_listBoxAdjParams"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 4 0 0">
                        <Button x:Name="_btnAdjParamsToInc" Content="{Binding Path=[AdjParams_WriteToInc].Value, Source={x:Static local:Main.Captions}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 4 0 0">
                        <Button x:Name="_btnRemoveAdjParam" Content="{Binding Path=[AdjParams_Remove].Value, Source={x:Static local:Main.Captions}}" Margin="0 0 4 0"/>
                        <Button x:Name="_btnAddAdjParam" Content=" + "/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
