<UserControl x:Class="SpelAnalysisTool.ViewMainPanel.PaneCycle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool.ViewMainPanel"
             xmlns:vc="clr-namespace:SpelAnalysisTool.ViewControls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <TabControl>
            <TabItem x:Name="_tabCycle" Cursor="">
                <TabItem.Header>
                    <vc:ListInfoHeaderControl x:Name="_headerCycle" TxtName="Cycle"/>
                </TabItem.Header>
                <DataGrid
                    x:Name="_dataGrid"
                    Margin="4"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    HorizontalGridLinesBrush="LightGray"
                    VerticalGridLinesBrush="LightGray"
                    HeadersVisibility="Column"
                    VerticalScrollBarVisibility="Visible"
                    SelectionMode="Single"
                    CanUserAddRows="False"
                    CanUserSortColumns="False"
                    CanUserResizeRows="False">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#eee"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Padding" Value="4 1"/>
                            <Setter Property="BorderBrush" Value="LightGray"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    </DataGrid.Resources>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
