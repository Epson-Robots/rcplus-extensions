<UserControl x:Class="SpelAnalysisTool.ViewMainPanel.MainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpelAnalysisTool"
             xmlns:vc="clr-namespace:SpelAnalysisTool.ViewControls"
             xmlns:vm="clr-namespace:SpelAnalysisTool.ViewMainPanel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <DockPanel Margin="8">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0 0 4 4">
                    <TextBox x:Name="_txtBoxLogName" Width="160" Text="{Binding Conf.Set.LogName}" MaxLength="32"/>
                </Grid>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="MinWidth" Value="98"/>
                            <Setter Property="Margin" Value="0 0 4 4"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button x:Name="_btnStartFunction" Content="{Binding Path=[Hdr_StartFunction].Value, Source={x:Static local:Main.Captions}}"/>
                    <Button x:Name="_btnLoadCSV" Content="{Binding Path=[Hdr_LoadCSV].Value, Source={x:Static local:Main.Captions}}"/>
                    <Button x:Name="_btnAddSpelLogger" Content="{Binding Path=[Hdr_AddSpelLogger].Value, Source={x:Static local:Main.Captions}}"/>
                    <Button x:Name="_btnLayout" Content="{Binding Path=[Hdr_Layout].Value, Source={x:Static local:Main.Captions}}"/>
                </WrapPanel>
                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <WrapPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="2 0 2 4"/>
                            <Setter Property="Width" Value="44"/>
                        </Style>
                        <Style TargetType="RepeatButton">
                            <Setter Property="MinWidth" Value="22"/>
                            <Setter Property="Margin" Value="0 0 0 4"/>
                        </Style>
                    </WrapPanel.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cycle"/>
                        <RepeatButton x:Name="_btnCycleLeft" Content="&lt;"/>
                        <RepeatButton x:Name="_btnCycleRight" Content="&gt;"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Section"/>
                        <RepeatButton x:Name="_btnSectionLeft" Content="&lt;"/>
                        <RepeatButton x:Name="_btnSectionRight" Content="&gt;"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Motion"/>
                        <RepeatButton x:Name="_btnMotionLeft" Content="&lt;"/>
                        <RepeatButton x:Name="_btnMotionRight" Content="&gt;"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
            <Grid Margin="0 8 0 0" x:Name="_grid">
            </Grid>
        </DockPanel>
        <vc:SelectSrcToDstControl x:Name="_layout" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"/>
    </Grid>
</UserControl>
